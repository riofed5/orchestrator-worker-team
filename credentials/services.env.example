# Company toolbox. Copy this file to services.env and fill that copy in.
# Leave this one blank. services.env is never committed, shared or pasted
# anywhere. See README.md in this folder.
#
# Each line is one service account the team may use. Project-level keys (a
# database URL, an app password) do NOT go here; they live in each project's
# own .env.local. Adding a service is a decision for the lead; ask on the board.

# Vercel  ->  vercel.com  ->  Account Settings  ->  Tokens  ->  Create
VERCEL_TOKEN=

# Supabase  ->  supabase.com/dashboard/account/tokens  ->  Generate new token
# (account token for the Supabase CLI; a project's URL and keys stay in that
# project's .env.local)
SUPABASE_ACCESS_TOKEN=

# GitHub  ->  github.com/settings/tokens  ->  Generate new token (repo scope)
GH_TOKEN=
